# Flask secret key — change this to a long random string in production
FLASK_SECRET_KEY=change-this-to-a-long-random-secret

# Strava API credentials — register your app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# OAuth callback URL — must match the redirect URI registered in your Strava app
# For local development, set "Authorization Callback Domain" to "localhost" in Strava settings
STRAVA_REDIRECT_URI=http://localhost:5000/auth/callback
